# =============================================================================
# Bivaro Buchhaltung - Umgebungsvariablen
# =============================================================================
# Kopieren Sie diese Datei nach .env und passen Sie die Werte an:
# cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# Datenbank
# -----------------------------------------------------------------------------
# SQLite-Datenbank Pfad (relativ zum Projekt-Root)
DATABASE_URL="file:./data/prod.db"

# -----------------------------------------------------------------------------
# NextAuth.js Konfiguration
# -----------------------------------------------------------------------------
# Generieren Sie ein Secret mit: openssl rand -base64 32
NEXTAUTH_SECRET="your-super-secret-key-change-this-in-production"

# URL der Anwendung (für OAuth Callbacks und CSRF-Schutz)
NEXTAUTH_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# Optionale Konfiguration
# -----------------------------------------------------------------------------
# Node Environment (development, production, test)
# NODE_ENV="production"

# Port für den Server (Standard: 3000)
# PORT=3000

# -----------------------------------------------------------------------------
# Optionaler E-Mail-Versand (SMTP)
# -----------------------------------------------------------------------------
# SMTP-Server für den Versand von Rechnungen, Angeboten und Mahnungen.
# Alle sechs Variablen sind optional. Ohne SMTP_HOST ist nur die
# E-Mail-Vorschau verfügbar; der Versand-Button wird in der UI deaktiviert.
# Zugangsdaten bleiben in Umgebungsvariablen und werden nicht in der Datenbank gespeichert.
#
# Empfohlene Ports:
#   587  – STARTTLS  → SMTP_SECURE=false  (Standard, von den meisten Anbietern empfohlen)
#   465  – Impl. TLS → SMTP_SECURE=true
#
# Beispiele:
#   Gmail:    SMTP_HOST=smtp.gmail.com       SMTP_PORT=587  SMTP_SECURE=false
#   Outlook:  SMTP_HOST=smtp.office365.com   SMTP_PORT=587  SMTP_SECURE=false
#   Strato:   SMTP_HOST=smtp.strato.de       SMTP_PORT=465  SMTP_SECURE=true
#   IONOS:    SMTP_HOST=smtp.ionos.de        SMTP_PORT=587  SMTP_SECURE=false
#
# SMTP_HOST="smtp.example.de"
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER="smtp-user@example.de"
# SMTP_PASSWORD="change-this-password"
# EMAIL_FROM="Bivaro <rechnung@example.de>"
