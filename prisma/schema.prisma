generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model AppSettings {
  id                    Int      @id @default(autoincrement())
  allowRegistration     Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String?
  role      String   @default("USER") // USER, ADMIN
  createdAt DateTime @default(now())
  expenses  Expense[]
  incomes   Income[]
  invoices  Invoice[]
  customers Customer[]
  settings  Settings?
  templates InvoiceTemplate[]
  recurringExpenses RecurringExpense[]
}

model Expense {
  id                    Int      @id @default(autoincrement())
  description           String
  amount                Float
  date                  DateTime @default(now())
  category              String?
  receiptUrl            String?
  taxRelevant           Boolean  @default(true)
  taxDeductiblePercentage Float?  // Adding back the dropped field
  receiptFileName       String?  // Originalname der hochgeladenen Belegdatei
  storedReceiptFileName String?  // Eindeutiger gespeicherter Dateiname des Belegs
  depreciationYears     Int?     // Nutzungsdauer in Jahren (AfA)
  userId                String
  user                  User     @relation(fields: [userId], references: [id])
}

model Income {
  id          Int      @id @default(autoincrement())
  description String
  amount      Float
  date        DateTime @default(now())
  customerId  Int?
  customer    Customer? @relation(fields: [customerId], references: [id])
  invoiceId   Int?     @unique
  taxRelevant Boolean  @default(true)
  invoice     Invoice? @relation(fields: [invoiceId], references: [id])
  userId      String
  user        User     @relation(fields: [userId], references: [id])
}

model Invoice {
  id            Int       @id @default(autoincrement())
  fileName      String
  storedFileName String   // Hinzugefügtes Feld für den gespeicherten Dateinamen
  uploadedAt    DateTime  @default(now())
  invoiceDate   DateTime?
  dueDate       DateTime?
  invoiceNumber String? @unique
  parsedData    Json
  totalAmount   Float?
  status        String    @default("DRAFT") // DRAFT, SENT, PAID
  paidAt        DateTime?
  customerId    Int?
  income        Income?
  customer      Customer? @relation(fields: [customerId], references: [id])
  userId        String
  user          User      @relation(fields: [userId], references: [id])
}

model Customer {
  id        Int       @id @default(autoincrement())
  name      String
  email     String?
  address   String?
  zipCode   String?
  city      String?
  taxNumber String?
  createdAt DateTime  @default(now())
  invoices  Invoice[]
  incomes   Income[]
  userId    String
  user      User      @relation(fields: [userId], references: [id])
}

model Settings {
  id             Int     @id @default(autoincrement())
  companyName    String?
  companyAddress String?
  email          String?
  telephone      String?
  taxNumber      String?
  bankName       String?
  iban           String?
  bic            String?
  footerText     String?
  logoUrl        String?
  userId         String  @unique
  user           User    @relation(fields: [userId], references: [id])
}

model InvoiceTemplate {
  id        Int      @id @default(autoincrement())
  name      String
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String
  user      User     @relation(fields: [userId], references: [id])
}

model RecurringExpense {
  id                    Int      @id @default(autoincrement())
  description           String
  amount                Float
  category              String?
  taxRelevant           Boolean  @default(true)
  taxDeductiblePercentage Float? @default(100)
  interval              String   // MONTHLY, QUARTERLY, YEARLY
  dayOfMonth            Int      @default(1) // Tag des Monats für die Ausführung
  startDate             DateTime @default(now())
  endDate               DateTime? // Optional: Enddatum
  lastExecuted          DateTime? // Wann wurde zuletzt eine Ausgabe erstellt
  nextExecution         DateTime // Nächste geplante Ausführung
  isActive              Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  userId                String
  user                  User     @relation(fields: [userId], references: [id])
}
