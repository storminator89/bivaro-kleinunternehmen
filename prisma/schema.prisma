generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model AppSettings {
  id                    Int      @id @default(autoincrement())
  // A single logical settings row is used by registration/bootstrap code.
  // Existing rows are normalised to unique legacy keys by the auth migration.
  singletonKey          String   @unique @default("global")
  allowRegistration     Boolean  @default(true)
  // Once the first administrator has been provisioned, this marker remains
  // set even if the user is later removed or the server restarts.
  bootstrapConsumedAt   DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

// Host-wide SMTP override. Password material is stored only as AES-GCM
// ciphertext; the encryption key is derived from NEXTAUTH_SECRET at runtime.
model SmtpSettings {
  id                  Int      @id @default(autoincrement())
  singletonKey        String   @unique @default("global")
  host                String
  port                Int
  secure              Boolean
  from                String
  user                String?
  passwordCiphertext  String?
  passwordIv          String?
  passwordTag         String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String?
  role      String   @default("USER") // USER, ADMIN
  // Incrementing this value invalidates all JWTs issued before the change.
  sessionVersion Int    @default(0)
  deactivatedAt DateTime?
  createdAt DateTime @default(now())
  expenses  Expense[]
  incomes   Income[]
  invoices  Invoice[]
  customers Customer[]
  settings  Settings?
  annualBusinessContextRevisions AnnualBusinessContextRevision[]
  templates InvoiceTemplate[]
  recurringExpenses RecurringExpense[]
  reminders Reminder[]
  apiKeys   ApiKey[]
  apiLogs   ApiLog[]
  auditLogs AuditLog[]
  cashBooks CashBook[]
  cashTransactions CashTransaction[]
  documentations Documentation[]
  serviceProjects ServiceProject[]
  billingNotes BillingNote[]
  purchaseDocuments PurchaseDocument[]
  purchaseValidationReports PurchaseValidationReport[]
  suppliers Supplier[]
  aiProviderSettings AiProviderSettings?
  paymentJournalEvents PaymentJournalEvent[]
  paymentAdjustments PaymentAdjustment[]
  paymentOperations PaymentOperation[]
  dataImportBatches DataImportBatch[]
  bankImportBatches BankImportBatch[]
  bankImportRows BankImportRow[]
  emailOutbox EmailOutbox[]
  serviceArticles ServiceArticle[]
  serviceBillingPlans ServiceBillingPlan[]
  serviceBillingPeriods ServiceBillingPeriod[]
}

// Shared, bounded rate-limit state for authentication and other API surfaces.
// The key is a one-way hash of a logical scope/value pair.
model RateLimitBucket {
  id               Int      @id @default(autoincrement())
  key              String   @unique
  count            Int      @default(0)
  windowStartedAt  DateTime
  blockedUntil     DateTime?
  updatedAt        DateTime @updatedAt

  @@index([updatedAt])
}

model Expense {
  id                    Int      @id @default(autoincrement())
  description           String
  amount                Float
  date                  DateTime @default(now())
  category              String?
  receiptUrl            String?
  taxRelevant           Boolean  @default(true)
  taxDeductiblePercentage Float?  // Adding back the dropped field
  receiptFileName       String?  // Originalname der hochgeladenen Belegdatei
  storedReceiptFileName String?  // Eindeutiger gespeicherter Dateiname des Belegs
  depreciationYears     Int?     // Nutzungsdauer in Jahren (AfA)
  recurringExpenseId    Int?
  scheduledDate         DateTime?
  recurringExpense      RecurringExpense? @relation(fields: [recurringExpenseId], references: [id], onDelete: SetNull)
  userId                String
  user                  User     @relation(fields: [userId], references: [id])
  cashTransaction       CashTransaction?
  purchaseDocument      PurchaseDocument?

  @@unique([recurringExpenseId, scheduledDate])
  @@index([userId, date])
}

model Income {
  id          Int      @id @default(autoincrement())
  description String
  amount      Float
  date        DateTime @default(now())
  customerId  Int?
  customer    Customer? @relation(fields: [customerId], references: [id])
  invoiceId   Int?
  taxRelevant Boolean  @default(true)
  invoice     Invoice? @relation(fields: [invoiceId], references: [id])
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  cashTransaction CashTransaction?
  paymentJournalEvent PaymentJournalEvent?

  @@index([userId, date])
  @@index([userId, invoiceId])
}

model Invoice {
  id            Int       @id @default(autoincrement())
  type          String    @default("INVOICE")  // INVOICE, CREDIT_NOTE oder QUOTE
  fileName      String
  storedFileName String   // Hinzugefügtes Feld für den gespeicherten Dateinamen
  uploadedAt    DateTime  @default(now())
  invoiceDate   DateTime?
  dueDate       DateTime?
  invoiceNumber String?
  parsedData    Json
  totalAmount   Float?
  status        String    @default("DRAFT") // DRAFT, SENT, PAID, CANCELLED
  // Conservative issuance proof: legacy/imported rows remain UNKNOWN until
  // an explicit lifecycle path proves they were never issued.
  issuanceState String    @default("UNKNOWN") // UNKNOWN, UNISSUED, ISSUED
  paidAt        DateTime?
  validUntil    DateTime? // Gültig bis (nur für Angebote/QUOTE)
  quoteFollowUpOn String? // YYYY-MM-DD, private in-app task; QUOTE only
  quoteResponseNote String? // User-declared response/context, never an acceptance proof
  originalInvoiceId Int?  // Referenz zur Originalrechnung (bei Gutschriften)
  originalInvoice   Invoice? @relation("CreditNotes", fields: [originalInvoiceId], references: [id])
  creditNotes       Invoice[] @relation("CreditNotes")
  cancellationReason String? // Grund für Stornierung
  serviceBillingPeriod ServiceBillingPeriod?
  convertedFromQuoteId Int? @unique
  convertedFromQuote Invoice? @relation("QuoteConversion", fields: [convertedFromQuoteId], references: [id], onDelete: SetNull)
  convertedInvoice Invoice? @relation("QuoteConversion")
  customerId    Int?
  incomes       Income[]
  paymentJournalEvents PaymentJournalEvent[]
  paymentAdjustments PaymentAdjustment[] @relation("AdjustedInvoice")
  refundBasisAdjustments PaymentAdjustment[] @relation("RefundBasis")
  billingNotes  BillingNote[]
  emailOutbox EmailOutbox[]
  reminders     Reminder[]
  customer      Customer? @relation(fields: [customerId], references: [id])
  userId        String
  user          User      @relation(fields: [userId], references: [id])

  @@unique([userId, invoiceNumber])
  @@index([userId, type, uploadedAt])
  @@index([userId, type, quoteFollowUpOn])
  @@index([userId, status])
}

model Customer {
  id              Int       @id @default(autoincrement())
  name            String
  contactPerson   String?   // Ansprechpartner
  email           String?
  phone           String?   // Telefonnummer
  address         String?
  zipCode         String?
  city            String?
  taxNumber       String?
  internalNote    String?
  noteVisibility  String    @default("BOTH") // EDITOR, SEND, BOTH
  paymentTermDays Int?      // Explicit optional default, 0..365 calendar days
  serviceBillingPlans ServiceBillingPlan[]
  createdAt       DateTime  @default(now())
  invoices        Invoice[]
  incomes         Income[]
  serviceProjects ServiceProject[]
  billingNotes    BillingNote[]
  userId          String
  user            User      @relation(fields: [userId], references: [id])

  @@unique([id, userId])
}

model ServiceProject {
  id          Int       @id @default(autoincrement())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  customerId  Int
  customer    Customer  @relation(fields: [customerId, userId], references: [id, userId], onDelete: Restrict)
  name        String
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  billingNotes BillingNote[]

  @@unique([id, customerId, userId])
  @@index([userId, customerId, archivedAt])
}

// A reusable customer service line. An invoice claims a note only once it
// has been matched to a parsed invoice line inside the invoice transaction.
model BillingNote {
  id          Int       @id @default(autoincrement())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  customerId  Int
  customer    Customer  @relation(fields: [customerId], references: [id], onDelete: Restrict)
  serviceDate DateTime
  description String
  quantity    Float     @default(1)
  unit        String    @default("Stunde")
  projectId   Int?
  project     ServiceProject? @relation(fields: [projectId, customerId, userId], references: [id, customerId, userId], onDelete: Restrict)
  durationMinutes Int?
  captureKey String?
  captureFingerprint String?
  deletedAt DateTime?
  invoiceId   Int?
  invoice     Invoice?  @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId, customerId, invoiceId])
  @@index([userId, serviceDate])

  @@unique([userId, captureKey])
}

model Settings {
  id             Int     @id @default(autoincrement())
  companyName    String?
  companyAddress String?
  email          String?
  telephone      String?
  taxNumber      String?
  bankName       String?
  iban           String?
  bic            String?
  footerText     String?
  paymentTermDays Int?    // Explicit optional default, 0..365 calendar days
  logoUrl        String?
  // Explicit user declaration, never inferred from turnover or invoice history.
  // Existing settings remain unconfirmed until the user makes a selection.
  fiscalTaxRegime     String    @default("UNSET") // UNSET, SMALL_BUSINESS, STANDARD
  fiscalEffectiveFrom String?   // ISO calendar date (YYYY-MM-DD), not a timezone instant
  fiscalConfirmedAt   DateTime? // Server time of the explicit declaration
  // API CORS-Konfiguration
  allowedOrigins String? // JSON-Array von erlaubten Origins, z.B. ["https://example.com", "https://app.example.com"]
  userId         String  @unique
  user           User    @relation(fields: [userId], references: [id])
}

model InvoiceTemplate {
  id        Int      @id @default(autoincrement())
  name      String
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String
  user      User     @relation(fields: [userId], references: [id])
}

model RecurringExpense {
  expenses              Expense[]
  id                    Int      @id @default(autoincrement())
  description           String
  amount                Float
  category              String?
  taxRelevant           Boolean  @default(true)
  taxDeductiblePercentage Float? @default(100)
  interval              String   // MONTHLY, QUARTERLY, YEARLY
  dayOfMonth            Int      @default(1) // Tag des Monats für die Ausführung
  startDate             DateTime @default(now())
  endDate               DateTime? // Optional: Enddatum
  lastExecuted          DateTime? // Wann wurde zuletzt eine Ausgabe erstellt
  nextExecution         DateTime // Nächste geplante Ausführung
  isActive              Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  userId                String
  user                  User     @relation(fields: [userId], references: [id])
}

model Reminder {
  id            Int       @id @default(autoincrement())
  invoiceId     Int
  invoice       Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  reminderLevel Int       @default(1) // 1 = Zahlungserinnerung, 2 = 1. Mahnung, 3 = 2. Mahnung, 4 = Letzte Mahnung
  sentAt        DateTime  @default(now())
  dueDate       DateTime  // Fälligkeitsdatum der Mahnung
  fee           Float     @default(0) // Mahngebühren
  notes         String?   // Notizen/Kommentar
  createdAt     DateTime  @default(now())
  userId        String
  user          User      @relation(fields: [userId], references: [id])
  // User-confirmed rest-balance evidence; never modifies the source invoice.
  idempotencyKey String?
  balanceSnapshot Json?

  @@unique([userId, idempotencyKey])
}

// API Key for external REST API access
model ApiKey {
  id          Int       @id @default(autoincrement())
  name        String    // User-friendly name for the key
  keyHash     String    @unique // SHA-256 hash of the actual key
  keyPrefix   String    // First few characters for identification (e.g., "biv_sk_abc...")
  scopes      String?   // JSON array of scopes: ["read", "write", "delete"]
  isActive    Boolean   @default(true)
  expiresAt   DateTime? // Optional expiration date
  lastUsedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs        ApiLog[]
}

// API Access Logs for audit trail
model ApiLog {
  id           Int      @id @default(autoincrement())
  apiKeyId     Int
  apiKey       ApiKey   @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  method       String   // GET, POST, PUT, DELETE
  endpoint     String   // /api/v1/customers
  statusCode   Int      // 200, 401, 500, etc.
  ipAddress    String?
  userAgent    String?
  requestBody  String?  // Truncated request body for debugging
  responseTime Int?     // Response time in ms
  createdAt    DateTime @default(now())
}

// Audit Log for tracking all data changes
model AuditLog {
  id            Int      @id @default(autoincrement())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action        String   // CREATE, UPDATE, DELETE, LOGIN, LOGOUT, EXPORT, etc.
  entityType    String   // Customer, Invoice, Expense, Income, Settings, etc.
  entityId      String?  // ID of the affected entity
  entityName    String?  // Human-readable name (e.g., customer name, invoice number)
  oldValues     String?  // JSON of old values (for updates)
  newValues     String?  // JSON of new values (for creates/updates)
  changedFields String?  // JSON array of field names that changed
  ipAddress     String?
  userAgent     String?
  sessionId     String?  // For tracking user sessions
  metadata      String?  // Additional context as JSON
  createdAt     DateTime @default(now())
  
  @@index([userId])
  @@index([entityType, entityId])
  @@index([action])
  @@index([createdAt])
}

// Kassenbuch (Cash Book) for cash transaction tracking per § 146 AO
model CashBook {
  id             Int      @id @default(autoincrement())
  name           String   @default("Hauptkasse")
  description    String?
  initialBalance Float    @default(0)
  currency       String   @default("EUR")
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions   CashTransaction[]
  
  @@index([userId])
}

// Kassenbuch-Transaktionen (Cash Book Transactions)
model CashTransaction {
  id              Int      @id @default(autoincrement())
  date            DateTime @default(now())
  type            String   // EINNAHME, AUSGABE
  description     String
  amount          Float    // Immer positiv, Typ bestimmt Richtung
  runningBalance  Float    // Laufender Kassenbestand nach dieser Transaktion
  category        String?
  receiptNumber   String?  // Belegnummer
  taxRelevant     Boolean  @default(true)
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  // Beziehung zum Kassenbuch
  cashBookId      Int
  cashBook        CashBook @relation(fields: [cashBookId], references: [id], onDelete: Cascade)
  
  // Beziehung zum Benutzer
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Optionale Verknüpfung mit bestehenden Ausgaben/Einnahmen
  expenseId       Int?     @unique
  expense         Expense? @relation(fields: [expenseId], references: [id], onDelete: SetNull)
  incomeId        Int?     @unique
  income          Income?  @relation(fields: [incomeId], references: [id], onDelete: SetNull)
  
  @@index([cashBookId])
  @@index([userId])
  @@index([date])
  @@index([type])
}

// GoBD Verfahrensdokumentation
model Documentation {
  id              Int      @id @default(autoincrement())
  version         String   // Software-Version bei der die Doku erstellt/aktualisiert wurde
  title           String   @default("Verfahrensdokumentation")
  content         String   // JSON mit allen Dokumentations-Sektionen
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
}

// Counter reservations are committed with the document that consumes them.
model InvoiceNumberCounter {
  userId String
  type String
  year Int
  value Int

  @@id([userId, type, year])
}

// Incoming originals are source records, never sales invoices or automatic ledger entries.
model PurchaseDocument {
  id                  Int       @id @default(autoincrement())
  userId              String
  user                User      @relation(fields: [userId], references: [id])
  originalFileName    String
  storedFileName      String
  originalSha256      String
  originalByteCount   Int
  mediaType           String
  uploadedAt          DateTime  @default(now())
  uploadRequestId     String
  parsedData          Json?
  parseStatus         String    @default("PENDING") // PENDING, PARSED, FAILED
  parserVersion       String?
  parseErrorCode      String?
  supplierName        String?
  supplierId          Int?
  supplier            Supplier? @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  selectedSupplierSnapshot Json?
  invoiceNumber       String?
  invoiceDate         DateTime?
  currency            String?
  totalAmount         Float?
  reviewedSourceSnapshot Json?
  aiExtraction        Json?
  aiDraftProvenance   Json?
  aiApprovedSnapshot  Json?
  reviewDraftSearch   String?
  reviewDraft         Json?
  reviewDraftSavedAt  DateTime?
  reviewStatus        String    @default("REVIEW") // REVIEW, BOOKED, DISMISSED
  revision            Int       @default(0)
  expenseId           Int?      @unique
  expense             Expense?  @relation(fields: [expenseId], references: [id], onDelete: Restrict)
  approvalRequestId   String?
  approvalFingerprint String?
  approvedAt          DateTime?
  dismissedAt         DateTime?
  dismissalReason     String?
  updatedAt           DateTime  @updatedAt

  @@unique([userId, originalSha256])
  @@unique([userId, uploadRequestId])
  @@index([userId, reviewStatus, uploadedAt])
  @@index([userId, supplierName, invoiceNumber])
}

// Explicit tenant-owned purchase-side contacts, never sales Customers.
model Supplier {
  id Int @id @default(autoincrement())
  userId String
  user User @relation(fields: [userId], references: [id])
  name String
  address String?
  postalCode String?
  city String?
  country String?
  email String?
  phone String?
  taxId String?
  vatId String?
  revision Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  purchaseDocuments PurchaseDocument[]

  @@index([userId, name])
}

// Immutable positive allocations. Refunds/corrections are a separate workflow.
model PaymentJournalEvent {
  id             Int      @id @default(autoincrement())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  invoiceId      Int
  invoice        Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  incomeId       Int?     @unique
  income         Income?  @relation(fields: [incomeId], references: [id], onDelete: Restrict)
  // Canonical positive integer cents, serialized without lossy JSON numbers.
  amountCents    String
  currency       String   @default("EUR")
  paidAt         DateTime?
  dateCertainty  String
  source         String
  reference      String
  idempotencyKey String
  createdAt      DateTime @default(now())
  adjustments PaymentAdjustment[]

  @@unique([userId, idempotencyKey])
  @@index([userId, paidAt])
  @@index([userId, invoiceId, id])
}

// Optional annual context only; never read by invoice/tax classification code.
model AnnualBusinessContextRevision {
  id Int @id @default(autoincrement())
  userId String
  user User @relation(fields: [userId], references: [id])
  revision Int
  contextYear Int
  effectiveFrom String
  foundingYear Int?
  previousYearTurnoverCents String?
  previousYearExternalTurnoverCents String?
  completeness String
  sourceNote String
  declaredAt DateTime @default(now())

  @@unique([userId, revision])
  @@index([userId, contextYear, revision])
}

// Operational replay receipts. Business records remain customers/templates and
// already participate in tenant backups; receipts are not business documents.
model DataImportBatch {
  id Int @id @default(autoincrement())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  requestId String
  fingerprint String
  kind String
  result Json
  createdAt DateTime @default(now())

  @@unique([userId, requestId])
}

// Reusable sales lines. This is catalog data, never a fiscal profile or document.
model ServiceArticle {
  id Int @id @default(autoincrement())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  name String
  nameKey String
  description String
  unit String
  unitPriceCents String
  sourcePriceCents String
  sourcePriceBasis String
  taxRate String
  createdAt DateTime @default(now())

  @@unique([userId, nameKey])
}

// Per-tenant optional AI configuration. Entire model is excluded from business backups.
model AiProviderSettings {
  userId                String   @id
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  enabled               Boolean  @default(false)
  autoAnalyzeNewUploads Boolean  @default(false)
  baseUrl               String
  model                 String
  configurationRevision String   @default(uuid())
  keyCiphertext         String?
  keyIv                 String?
  keyTag                String?
  version               Int      @default(1)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

// Private planning only. Creating a plan or preview NEVER issues a document.
model ServiceBillingPlan {
  id String @id @default(uuid())
  // Tenant-scoped portable identity survives full backups and owner remapping.
  stableKey String @default(uuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  customerId Int
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  name String
  cadence String // MONTHLY, QUARTERLY, YEARLY; fixed after creation
  anchorDate String // YYYY-MM-DD, fixed calendar anchor; not a timezone instant
  taxMode String // small-business, standard; explicit native document selection
  items Json
  nextPeriod Int @default(0)
  status String @default("ACTIVE") // ACTIVE, PAUSED
  revision Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  periods ServiceBillingPeriod[]

  @@unique([userId, stableKey])
  @@index([userId, status])
}

// Retained even after draft deletion. Unique plan/index forbids regeneration.
model ServiceBillingPeriod {
  id String @id @default(uuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId String
  plan ServiceBillingPlan @relation(fields: [planId], references: [id], onDelete: Restrict)
  periodIndex Int
  periodStart String
  periodEnd String
  action String // GENERATED or SKIPPED; never an issuance/payment record
  invoiceId Int? @unique
  invoice Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@unique([planId, periodIndex])
  @@index([userId, planId])
}

// Shared tenant-wide replay namespace for upgraded financial commands.
model PaymentOperation {
  id Int @id @default(autoincrement())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  idempotencyKey String
  kind String
  createdAt DateTime @default(now())
  adjustment PaymentAdjustment?
  @@unique([userId, idempotencyKey])
}

// Append-only evidence; never rewrites its positive payment or Income projection.
model PaymentAdjustment {
  id Int @id @default(autoincrement())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  invoiceId Int
  invoice Invoice @relation("AdjustedInvoice", fields: [invoiceId], references: [id], onDelete: Restrict)
  originalPaymentId Int
  originalPayment PaymentJournalEvent @relation(fields: [originalPaymentId], references: [id], onDelete: Restrict)
  kind String
  amountCents String
  currency String @default("EUR")
  actionDate DateTime
  accountingEffectiveOn DateTime
  reason String
  reference String
  payoutEvidenceIdentity String?
  cancellationInvoiceId Int?
  cancellationInvoice Invoice? @relation("RefundBasis", fields: [cancellationInvoiceId], references: [id], onDelete: Restrict)
  basisSnapshot Json?
  idempotencyKey String
  operation PaymentOperation @relation(fields: [userId, idempotencyKey], references: [userId, idempotencyKey], onDelete: Restrict, onUpdate: Restrict)
  semanticFingerprint String
  contractVersion Int @default(2)
  recordedAt DateTime @default(now())
  @@unique([userId, idempotencyKey])
  @@unique([userId, payoutEvidenceIdentity])
  @@index([userId, invoiceId, id])
  @@index([userId, accountingEffectiveOn])
}

// Immutable, manually confirmed envelopes. Never a queue or delivery/read proof.
model EmailOutbox {
  id String @id @default(uuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  invoiceId Int?
  invoice Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  sourceInvoiceId Int
  documentType String
  requestId String
  fingerprint String
  attachmentSha256 String
  storedFileName String
  attachmentFileName String
  from String
  replyTo String?
  to String
  cc String
  bcc String
  subject String
  text String
  state String @default("PREPARED")
  currentAttemptId String?
  processingExpiresAt DateTime?
  messageId String?
  errorCode String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  attempts EmailOutboxAttempt[]

  @@unique([userId, requestId])
  @@unique([userId, fingerprint])
  @@index([userId, invoiceId, createdAt])
  @@index([userId, documentType, attachmentSha256])
}

// A new explicit retry appends an attempt; previous outcomes are not overwritten.
model EmailOutboxAttempt {
  id String @id @default(uuid())
  outboxId String
  outbox EmailOutbox @relation(fields: [outboxId], references: [id], onDelete: Restrict)
  requestId String
  sequence Int
  duplicateRiskAcknowledged Boolean @default(false)
  uncertaintyRecordedAt DateTime?
  state String
  startedAt DateTime @default(now())
  finishedAt DateTime?
  messageId String?
  errorCode String?

  @@unique([outboxId, requestId])
  @@unique([outboxId, sequence])
}

// Append-only technical evidence. Tenant+original hash is the authoritative source
// identity across restore; numeric document ID is an informational snapshot only.
model PurchaseValidationReport {
  id String @id @default(uuid())
  stableKey String
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  originalSha256 String
  sourceDocumentIdAtCheck Int
  requestId String
  fingerprint String
  provenance String @default("LOCAL") // LOCAL, IMPORTED_HISTORIC
  report Json
  checkedAt DateTime
  createdAt DateTime @default(now())

  @@unique([userId, stableKey])
  @@unique([userId, requestId])
  @@index([userId, originalSha256, checkedAt])
}

// Immutable, explicitly confirmed bank evidence; never a payment or ledger entry.
model BankImportBatch {
  id             Int      @id @default(autoincrement())
  stableKey      String   @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  requestId      String
  fingerprint    String
  sourceSha256   String
  sourceBytes    Int
  parserVersion  String
  mappingVersion String
  accountAlias   String
  delimiter      String
  mapping        Json
  receipt        Json
  createdAt      DateTime @default(now())
  rows           BankImportRow[]

  @@unique([userId, stableKey])
  @@unique([userId, requestId])
  @@unique([userId, fingerprint])
  @@index([userId, id])
  @@index([userId, sourceSha256])
}

model BankImportRow {
  id           Int      @id @default(autoincrement())
  stableKey    String   @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  batchId      Int
  batch        BankImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  sourceRow    Int
  evidence     Json
  externalKey  String?
  contentKey   String?
  dayAmountKey String?

  @@unique([userId, stableKey])
  @@unique([batchId, sourceRow])
  @@index([userId, externalKey])
  @@index([userId, contentKey])
  @@index([userId, dayAmountKey])
}
