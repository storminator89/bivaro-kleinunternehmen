generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String?
  createdAt DateTime @default(now())
}

model Expense {
  id                    Int      @id @default(autoincrement())
  description           String
  amount                Float
  date                  DateTime @default(now())
  category              String?
  receiptUrl            String?
  taxRelevant           Boolean  @default(true)
  taxDeductiblePercentage Float?  // Adding back the dropped field
  receiptFileName       String?  // Originalname der hochgeladenen Belegdatei
  storedReceiptFileName String?  // Eindeutiger gespeicherter Dateiname des Belegs
}

model Income {
  id          Int      @id @default(autoincrement())
  description String
  amount      Float
  date        DateTime @default(now())
  customerId  Int?
  customer    Customer? @relation(fields: [customerId], references: [id])
  invoiceId   Int?     @unique
  taxRelevant Boolean  @default(true)
  invoice     Invoice? @relation(fields: [invoiceId], references: [id])
}

model Invoice {
  id            Int       @id @default(autoincrement())
  fileName      String
  storedFileName String   // Hinzugefügtes Feld für den gespeicherten Dateinamen
  uploadedAt    DateTime  @default(now())
  invoiceDate   DateTime?
  dueDate       DateTime?
  invoiceNumber String?
  parsedData    Json
  totalAmount   Float?
  paidStatus    Boolean   @default(false)
  paidDate      DateTime?
  customerId    Int?
  income        Income?
  customer      Customer? @relation(fields: [customerId], references: [id])
}

model Customer {
  id        Int       @id @default(autoincrement())
  name      String
  email     String?
  address   String?
  taxNumber String?
  createdAt DateTime  @default(now())
  invoices  Invoice[]
  incomes   Income[]
}
