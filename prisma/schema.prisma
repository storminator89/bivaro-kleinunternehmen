generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model AppSettings {
  id                    Int      @id @default(autoincrement())
  allowRegistration     Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String?
  role      String   @default("USER") // USER, ADMIN
  createdAt DateTime @default(now())
  expenses  Expense[]
  incomes   Income[]
  invoices  Invoice[]
  customers Customer[]
  settings  Settings?
  templates InvoiceTemplate[]
  recurringExpenses RecurringExpense[]
  reminders Reminder[]
  apiKeys   ApiKey[]
  apiLogs   ApiLog[]
  auditLogs AuditLog[]
}

model Expense {
  id                    Int      @id @default(autoincrement())
  description           String
  amount                Float
  date                  DateTime @default(now())
  category              String?
  receiptUrl            String?
  taxRelevant           Boolean  @default(true)
  taxDeductiblePercentage Float?  // Adding back the dropped field
  receiptFileName       String?  // Originalname der hochgeladenen Belegdatei
  storedReceiptFileName String?  // Eindeutiger gespeicherter Dateiname des Belegs
  depreciationYears     Int?     // Nutzungsdauer in Jahren (AfA)
  userId                String
  user                  User     @relation(fields: [userId], references: [id])
}

model Income {
  id          Int      @id @default(autoincrement())
  description String
  amount      Float
  date        DateTime @default(now())
  customerId  Int?
  customer    Customer? @relation(fields: [customerId], references: [id])
  invoiceId   Int?     @unique
  taxRelevant Boolean  @default(true)
  invoice     Invoice? @relation(fields: [invoiceId], references: [id])
  userId      String
  user        User     @relation(fields: [userId], references: [id])
}

model Invoice {
  id            Int       @id @default(autoincrement())
  fileName      String
  storedFileName String   // Hinzugefügtes Feld für den gespeicherten Dateinamen
  uploadedAt    DateTime  @default(now())
  invoiceDate   DateTime?
  dueDate       DateTime?
  invoiceNumber String? @unique
  parsedData    Json
  totalAmount   Float?
  status        String    @default("DRAFT") // DRAFT, SENT, PAID
  paidAt        DateTime?
  customerId    Int?
  income        Income?
  reminders     Reminder[]
  customer      Customer? @relation(fields: [customerId], references: [id])
  userId        String
  user          User      @relation(fields: [userId], references: [id])
}

model Customer {
  id              Int       @id @default(autoincrement())
  name            String
  contactPerson   String?   // Ansprechpartner
  email           String?
  phone           String?   // Telefonnummer
  address         String?
  zipCode         String?
  city            String?
  taxNumber       String?
  createdAt       DateTime  @default(now())
  invoices        Invoice[]
  incomes         Income[]
  userId          String
  user            User      @relation(fields: [userId], references: [id])
}

model Settings {
  id             Int     @id @default(autoincrement())
  companyName    String?
  companyAddress String?
  email          String?
  telephone      String?
  taxNumber      String?
  bankName       String?
  iban           String?
  bic            String?
  footerText     String?
  logoUrl        String?
  // API CORS-Konfiguration
  allowedOrigins String? // JSON-Array von erlaubten Origins, z.B. ["https://example.com", "https://app.example.com"]
  userId         String  @unique
  user           User    @relation(fields: [userId], references: [id])
}

model InvoiceTemplate {
  id        Int      @id @default(autoincrement())
  name      String
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String
  user      User     @relation(fields: [userId], references: [id])
}

model RecurringExpense {
  id                    Int      @id @default(autoincrement())
  description           String
  amount                Float
  category              String?
  taxRelevant           Boolean  @default(true)
  taxDeductiblePercentage Float? @default(100)
  interval              String   // MONTHLY, QUARTERLY, YEARLY
  dayOfMonth            Int      @default(1) // Tag des Monats für die Ausführung
  startDate             DateTime @default(now())
  endDate               DateTime? // Optional: Enddatum
  lastExecuted          DateTime? // Wann wurde zuletzt eine Ausgabe erstellt
  nextExecution         DateTime // Nächste geplante Ausführung
  isActive              Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  userId                String
  user                  User     @relation(fields: [userId], references: [id])
}

model Reminder {
  id            Int       @id @default(autoincrement())
  invoiceId     Int
  invoice       Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  reminderLevel Int       @default(1) // 1 = Zahlungserinnerung, 2 = 1. Mahnung, 3 = 2. Mahnung, 4 = Letzte Mahnung
  sentAt        DateTime  @default(now())
  dueDate       DateTime  // Fälligkeitsdatum der Mahnung
  fee           Float     @default(0) // Mahngebühren
  notes         String?   // Notizen/Kommentar
  createdAt     DateTime  @default(now())
  userId        String
  user          User      @relation(fields: [userId], references: [id])
}

// API Key for external REST API access
model ApiKey {
  id          Int       @id @default(autoincrement())
  name        String    // User-friendly name for the key
  keyHash     String    @unique // SHA-256 hash of the actual key
  keyPrefix   String    // First few characters for identification (e.g., "biv_sk_abc...")
  scopes      String?   // JSON array of scopes: ["read", "write", "delete"]
  isActive    Boolean   @default(true)
  expiresAt   DateTime? // Optional expiration date
  lastUsedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs        ApiLog[]
}

// API Access Logs for audit trail
model ApiLog {
  id           Int      @id @default(autoincrement())
  apiKeyId     Int
  apiKey       ApiKey   @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  method       String   // GET, POST, PUT, DELETE
  endpoint     String   // /api/v1/customers
  statusCode   Int      // 200, 401, 500, etc.
  ipAddress    String?
  userAgent    String?
  requestBody  String?  // Truncated request body for debugging
  responseTime Int?     // Response time in ms
  createdAt    DateTime @default(now())
}

// Audit Log for tracking all data changes
model AuditLog {
  id            Int      @id @default(autoincrement())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action        String   // CREATE, UPDATE, DELETE, LOGIN, LOGOUT, EXPORT, etc.
  entityType    String   // Customer, Invoice, Expense, Income, Settings, etc.
  entityId      String?  // ID of the affected entity
  entityName    String?  // Human-readable name (e.g., customer name, invoice number)
  oldValues     String?  // JSON of old values (for updates)
  newValues     String?  // JSON of new values (for creates/updates)
  changedFields String?  // JSON array of field names that changed
  ipAddress     String?
  userAgent     String?
  sessionId     String?  // For tracking user sessions
  metadata      String?  // Additional context as JSON
  createdAt     DateTime @default(now())
  
  @@index([userId])
  @@index([entityType, entityId])
  @@index([action])
  @@index([createdAt])
}
